# 이 파일을 .env.local로 복사해 값을 채우면 실데이터 모드로 전환됩니다.

# ── 웹으로 띄울 때 (npm run dev / npm run build) ────────────────────────────
# 두 키 모두 서버에서만 읽습니다. 브라우저는 좌표만 보내고 결과만 받습니다.
# 여기에 NEXT_PUBLIC_ 접두사를 붙이면 웹 페이지를 여는 누구에게나 노출되므로
# 절대 붙이지 마세요.

# 오피넷(한국석유공사) 유가정보 오픈 API 인증키
# 발급: https://www.opinet.co.kr/user/custapi/custApiInfo.do
# 없으면 샘플 주유소 데이터로 동작합니다.
OPINET_CERT_KEY=

# 카카오 REST API 키 (카카오모빌리티 길찾기)
# 발급: https://developers.kakao.com
# 무료 한도: 자동차 길찾기 1일 10,000건 / 다중 경유지 1일 5,000건
# 없으면 샘플 경로와 기하학적 우회 추정으로 동작합니다.
KAKAO_REST_API_KEY=

# ── 안드로이드 APK로 빌드할 때 (npm run apk) ────────────────────────────────
# APK 안에는 대신 API를 불러 줄 서버가 없습니다. 앱이 직접 오피넷과 카카오를
# 부르므로 키가 번들에 박혀야 하고, 그래서 NEXT_PUBLIC_ 접두사가 필요합니다.
#
# 이 값들은 APK를 뜯으면 나옵니다. 서버 없이 도는 앱의 대가입니다. 배포용이
# 아니라 개인·프로젝트용일 때만 쓰세요. 위 서버용 키와 같은 값을 넣으면 됩니다.
#
# 비워 두면 APK는 샘플 데이터로만 동작합니다. 웹으로만 쓸 거라면 비워 두세요.
NEXT_PUBLIC_OPINET_CERT_KEY=
NEXT_PUBLIC_KAKAO_REST_API_KEY=
