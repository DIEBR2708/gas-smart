{
  "name": "cheapest-fuel-navigator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43127",
    "build": "next build",
    "start": "next start --port 43127",
    "build:app": "node scripts/build-app.mjs",
    "sync:app": "npm run build:app && npx cap sync android",
    "apk": "npm run sync:app && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run sync:app && cd android && ./gradlew assembleRelease",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/preferences": "^8.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "proj4": "^2.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
